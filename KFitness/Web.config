<?xml version="1.0"?>
<configuration>
	<connectionStrings>
		<add name="KFitnessConnection"
			 connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=KFitness;Integrated Security=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<system.webServer>
		<!-- Hace que index.html se cargue al entrar a la raiz del sitio -->
		<defaultDocument enabled="true">
			<files>
				<clear/>
				<add value="Pages/index.html"/>
			</files>
		</defaultDocument>
		<!-- Asegura los tipos MIME correctos para los recursos estaticos -->
		<staticContent>
			<remove fileExtension=".svg"/>
			<mimeMap fileExtension=".svg" mimeType="image/svg+xml"/>
			<remove fileExtension=".json"/>
			<mimeMap fileExtension=".json" mimeType="application/json"/>
			<remove fileExtension=".woff"/>
			<mimeMap fileExtension=".woff" mimeType="font/woff"/>
			<remove fileExtension=".woff2"/>
			<mimeMap fileExtension=".woff2" mimeType="font/woff2"/>
		</staticContent>
	</system.webServer>

	<system.web>
		<compilation debug="true"/>
		<authentication mode="Forms">
			<!-- Ruta corregida al login después de la reorganización del proyecto -->
			<forms loginUrl="/Pages/login.html" protection="All" timeout="30" slidingExpiration="true" />
		</authentication>
	</system.web>

	<!-- Rutas públicas: accesibles sin autenticación -->
	<location path="Api/servicios.ashx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<!-- Protege el panel de administración -->
	<location path="Pages/admin.html">
		<system.web>
			<authorization>
				<deny users="?" />
			</authorization>
		</system.web>
	</location>

	<!-- Protege todos los endpoints de la API de administración -->
	<location path="Api/admin">
		<system.web>
			<authorization>
				<deny users="?" />
			</authorization>
		</system.web>
	</location>

</configuration>